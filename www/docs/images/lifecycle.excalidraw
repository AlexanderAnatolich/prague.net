  "appState": {
    "gridSize": 20,
    "gridStep": 5,
    "gridModeEnabled": false,
    "viewBackgroundColor": "#ffffff",
    "customData": {
      "excalidraw_mcp": {
        "version": 2,
        "diagram_type": "state",
        "theme": "default",
        "spec": {
          "title": "A cache's life",
          "subtitle": "Readiness: Degraded while any cache is Loading. Liveness: Unhealthy on FatalLatched, PollLoopStalled, HandlerLoopFaulted, HandlerProcessingTimeout",
          "states": [
            {
              "id": "s",
              "label": "start",
              "kind": "start",
              "focal": false
            },
            {
              "id": "built",
              "label": "Constructed\nAddKafkaCaches: handlers, filters, consumer",
              "kind": "normal",
              "focal": false
            },
            {
              "id": "starting",
              "label": "Starting\nConsumeRawLoop on its own thread",
              "kind": "normal",
              "focal": false
            },
            {
              "id": "loading",
              "label": "Loading\nValueCompactingBuffer -> AddOrUpdate",
              "kind": "normal",
              "focal": false
            },
            {
              "id": "live",
              "label": "Live\nRawLiveWorker -> after-handlers",
              "kind": "normal",
              "focal": true
            },
            {
